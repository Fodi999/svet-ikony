# Copy to .env.local (Next.js) — values used by `npm run dev` (http://localhost:3000).
# Server-only secrets for local dev live in .dev.vars (see list below).
# The old Koyeb backend is retired: NEXT_PUBLIC_API_URL is no longer used.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Streamed real Earth for /pravoslavna-istoriya (Cesium World Imagery / Bing Aerial, World Terrain, OSM Buildings).
# Public by design (it ships to the browser): create a dedicated token in the Cesium ion dashboard, restrict it to
# your site URLs and to the assets it needs. Without it production keeps the self-hosted NASA layer and makes no ion request.
# NEXT_PUBLIC_CESIUM_ION_TOKEN=

# --- .dev.vars (local Cloudflare bindings; production: `wrangler secret put <NAME>`) ---
# ADMIN_JWT_SECRET=            # signs admin JWTs; admin's SVET_IKONY_ADMIN_TOKEN must be signed with it
# SITE_URL=http://localhost:3000
# ADMIN_PANEL_URL=http://localhost:3001   # admin panel dev server (npm run dev in svetikony-admin)
# TELEGRAM_BOT_TOKEN= / TELEGRAM_WEBHOOK_SECRET= / TELEGRAM_CHANNEL=@svit_ikony
# ADMIN_TELEGRAM_BOT_TOKEN= / ADMIN_TELEGRAM_WEBHOOK_SECRET=
# OPENAI_API_KEY= / OPENAI_MODEL= / OPENAI_IMAGE_MODEL= / AUTOPOST_TICK_SECRET=
