+
+/* Streamed Earth: compact Satellite | Map switch (+ dev-only Terrain / Buildings toggles). */
+.earthControl {position:absolute;left:32px;bottom:104px;display:flex;flex-direction:column;align-items:flex-start;gap:6px;z-index:6;pointer-events:auto;}
+.basemapSwitch {display:inline-flex;border:1px solid var(--line);border-radius:18px;background:var(--glass);overflow:hidden;}
+.basemapSwitch button {display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 12px;border:0;background:transparent;color:#aeb2b9;font-size:12px;letter-spacing:.02em;}
+.basemapSwitch button[aria-pressed=true] {color:var(--gold);background:#e8c77f1f;}
+.earthTools {display:flex;gap:12px;padding:6px 10px;border:1px solid var(--line);border-radius:14px;background:var(--glass);}
+.earthTools label {display:flex;align-items:center;gap:6px;color:#e7e9ec;font-size:11px;}
+.earthTools input {accent-color:#e8c77f;}
+@media(max-width:767px) {
+  .earthControl {left:14px;bottom:146px;}
+  .overlay:has(.detail) .earthControl,.overlay:has(.drawer) .earthControl {visibility:hidden;}
+}
+
+/* Attribution strip: Cesium ion / Google Maps / CesiumJS credits live in their own bottom container (CesiumWidget creditContainer)
+   and are never hidden or clipped. It sits in the free band under the timeline; "Data attribution" opens Cesium's full lightbox. */
+.credits {position:absolute;left:0;right:0;bottom:6px;min-height:22px;z-index:4;display:flex;align-items:center;justify-content:center;padding:0 16px;pointer-events:none;color:#b9bfc8;font-size:10px;line-height:22px;}
+.credits :global(.cesium-widget-credits) {position:static!important;display:flex!important;flex-wrap:wrap;align-items:center;justify-content:center;gap:0 8px;inset:auto!important;max-width:100%!important;padding:0!important;color:inherit;font-size:inherit!important;text-align:center;text-shadow:none;pointer-events:none;}
+.credits :global(.cesium-credit-logoContainer),.credits :global(.cesium-credit-textContainer) {display:inline-flex!important;flex-wrap:wrap;align-items:center;justify-content:center;gap:0 8px;}
+.credits :global(.cesium-credit-wrapper) {display:inline-flex!important;align-items:center;}
+.credits img {display:block;height:14px;width:auto;max-width:96px;object-fit:contain;opacity:.85;vertical-align:middle!important;}
+.credits a,.credits :global(.cesium-credit-expand-link) {display:inline-flex!important;align-items:center;color:#d8dce2;text-decoration:none;cursor:pointer;pointer-events:auto;}
+.credits a:hover,.credits :global(.cesium-credit-expand-link):hover {color:var(--gold,#e9c479);text-decoration:underline;}
+.credits :global(.cesium-credit-delimiter) {opacity:.6;}
+.experience :global(.cesium-credit-lightbox-overlay) {z-index:30;}
