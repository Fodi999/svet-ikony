{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "svet-ikony",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://ministerial-yetta-fodi999-c58d8823.koyeb.app",
    "NEXT_PUBLIC_SITE_URL": "https://svetikony.com",
    "TELEGRAM_CHANNEL": "@svit_ikony",
    // Phase 3B: the admin panel's real production origin, public (not
    // secret) config -- lib/telegram/admin-env.ts's getAdminTelegramConfig()
    // reads this to build the Telegram login button's URL. No hardcoded
    // fallback exists anywhere in code (see that file's own doc comment);
    // this is the one, real source of truth for it.
    "ADMIN_PANEL_URL": "https://svetikony-admin.fodi85999.workers.dev"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "svet-ikony"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svetikony-production",
      "database_id": "6d92cd43-d7f4-45ec-945c-c7a7ae1f3098"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "svetikony-media"
    }
  ]
}
